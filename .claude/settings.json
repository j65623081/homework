{
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.backup)",
      "Read(~/.ssh/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",

      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git clean*)",
      "Bash(git filter-branch*)",

      "Bash(composer require*)",
      "Bash(composer remove*)",
      "Bash(composer update*)",
      "Bash(php artisan install:api*)",

      "Bash(php artisan migrate*)",
      "Bash(php artisan db*)",
      "Bash(php artisan make:migration*)",
      "Bash(php artisan make:model*)",
      "Bash(docker*)",
      "Bash(docker-compose*)",
      "Bash(wget *)",

      "Write(homework.pdf)",
      "Edit(homework.pdf)",
      "Write(materials/**)",
      "Edit(materials/**)",
      "Write(naive/**)",
      "Edit(naive/**)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(composer*)",
      "Bash(curl*)",
      "Bash(php artisan*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  }
}
